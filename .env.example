# ===== 钉钉企业内部应用（开发者后台获取）=====
DINGTALK_CLIENT_ID=<fill-in>
DINGTALK_CLIENT_SECRET=<fill-in>

# ===== GitLab 私有化实例（PAT，权限: read_api + read_repository）=====
GITLAB_TOKEN=<fill-in>

# ===== 公司模型池（OpenAI 兼容端点统一 key）=====
LLM_POOL_KEY=<fill-in>


# ===== 管理控制台访问令牌（内网部署必须设置；本地开发可留空）=====
ADMIN_TOKEN=<fill-in>

# 注意：本文件复制为 .env 后填写真实值；.env 已在 .gitignore 中，禁止提交。
# 严禁在此配置任何云端观测凭据（如 LOGFIRE_TOKEN）。
